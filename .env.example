# Copy this file to .env and fill in the values.
# .env is ignored by Git — never commit real passwords.

# --- Database (used by docker-compose.yml and the backend) ---
POSTGRES_USER=caseuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=casesdb
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and each connection stalls ~60s.
POSTGRES_HOST=127.0.0.1
# 5433 avoids clashing with another PostgreSQL already using 5432.
POSTGRES_PORT=5433

# --- Backend ---
# "development" shows the interactive API docs at /docs; any other value hides them.
ENVIRONMENT=development

# --- Security ---
# Long random values, different for every installation. Generate each with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET signs login tokens (changing it logs everyone out).
JWT_SECRET=change-me
# AUDIT_SECRET keys the fingerprints of search text stored in the audit log.
AUDIT_SECRET=change-me

# --- Case assistant (chatbot, Step 13) ---
# Ollama runs the language model on this computer; case text is never sent to an outside service.
# Install Ollama, then: ollama pull qwen3:4b-instruct-2507-q4_K_M
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Total time allowed for one answer (seconds). Without a graphics card an answer takes about 2-4 minutes.
# Some browsers stop waiting after 300 seconds, so keep this below 300.
CHAT_TIMEOUT_SECONDS=280

# --- The whole application in Docker (Steps 14.1-14.2): docker compose --profile app up -d ---
# Inside Docker the API runs as "production" (no API docs; unsafe settings refused at start-up).
#APP_ENVIRONMENT=production
# Where the backend container finds Ollama (on the host computer).
#DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# The name people type in the browser, and the certificate for it:
#   TLS=internal                           Caddy's own certificate authority (testing, closed networks)
#   TLS=/certs/site.crt /certs/site.key    your organisation's certificate, in deploy/certs/
SITE_ADDRESS=localhost
TLS=internal
HTTP_PORT=8080
HTTPS_PORT=8443
# 127.0.0.1 = only this computer can connect. Serving other computers needs more care (Step 14.5).
WEB_BIND=127.0.0.1
# Failed logins allowed from one address within 15 minutes, for any accounts. Raise it if many users
# share one address (an office proxy), since they then share this allowance.
#MAX_FAILED_LOGINS_PER_IP=20

# --- Retention and backups (Step 14.3) ---
# Uploaded "new case" files are deleted after this many days (python -m scripts.retention, run daily).
UPLOAD_RETENTION_DAYS=30
# Audit entries are kept until your organisation sets a period here (in days).
#AUDIT_RETENTION_DAYS=
# Where backups go. They hold all the application's data: use an encrypted disk that is not synced
# to a cloud service (OneDrive, Google Drive...), and keep a second copy elsewhere.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- CDR Analysis integration (optional) ---
# When CDR Analysis services are running, set these to connect them.
# CDR_D1_JWT_KEY must match the AUTH_JWT_KEY of the D1 import backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
#CDR_D1_JWT_KEY=change-me-same-as-d1-auth-jwt-key
#CDR_D1_API_URL=http://127.0.0.1:55491
#CDR_D2_API_URL=http://127.0.0.1:55492
#CDR_D3_API_URL=http://127.0.0.1:55493
# India profile (remove comments to activate):
#CDR_MSISDN_RULE=in-msisdn.v1
#CDR_TIMEZONE=Asia/Kolkata
# Vite dev-server CDR proxy ports (defaults match config-templates/india_profile.env.example):
#CDR_D1_PORT=55491
#CDR_D2_PORT=55492
#CDR_D3_PORT=55493
