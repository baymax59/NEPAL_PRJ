# Copy this file to .env and fill in the values.
# .env is ignored by Git — never commit real passwords.

# --- Database (used by docker-compose.yml and the backend) ---
POSTGRES_USER=caseuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=casesdb
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and each connection stalls ~60s.
POSTGRES_HOST=127.0.0.1
# 5433 avoids clashing with another PostgreSQL already using 5432.
POSTGRES_PORT=5433

# --- Backend ---
# "development" shows the interactive API docs at /docs; any other value hides them.
ENVIRONMENT=development

# --- Security ---
# Long random values, different for every installation. Generate each with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET signs login tokens (changing it logs everyone out).
JWT_SECRET=change-me
# AUDIT_SECRET keys the fingerprints of search text stored in the audit log.
AUDIT_SECRET=change-me

# --- Case assistant (chatbot, Step 13) ---
# Ollama runs the language model on this computer; case text is never sent to an outside service.
# Install Ollama, then: ollama pull qwen3:4b-instruct-2507-q4_K_M
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Total time allowed for one answer (seconds). Without a graphics card an answer takes about 2-4 minutes.
# Some browsers stop waiting after 300 seconds, so keep this below 300.
CHAT_TIMEOUT_SECONDS=280

# --- The whole application in Docker (Steps 14.1-14.2): docker compose --profile app up -d ---
# Inside Docker the API runs as "production" (no API docs; unsafe settings refused at start-up).
#APP_ENVIRONMENT=production
# Where the backend container finds Ollama (on the host computer).
#DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# The name people type in the browser, and the certificate for it:
#   TLS=internal                           Caddy's own certificate authority (testing, closed networks)
#   TLS=/certs/site.crt /certs/site.key    your organisation's certificate, in deploy/certs/
SITE_ADDRESS=localhost
TLS=internal
HTTP_PORT=8080
HTTPS_PORT=8443
# 127.0.0.1 = only this computer can connect. Serving other computers needs more care (Step 14.5).
WEB_BIND=127.0.0.1
# Failed logins allowed from one address within 15 minutes, for any accounts. Raise it if many users
# share one address (an office proxy), since they then share this allowance.
#MAX_FAILED_LOGINS_PER_IP=20

# --- Retention and backups (Step 14.3) ---
# Uploaded "new case" files are deleted after this many days (python -m scripts.retention, run daily).
UPLOAD_RETENTION_DAYS=30
# Audit entries are kept until your organisation sets a period here (in days).
#AUDIT_RETENTION_DAYS=
# Where backups go. They hold all the application's data: use an encrypted disk that is not synced
# to a cloud service (OneDrive, Google Drive...), and keep a second copy elsewhere.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Case Management evidence (Step 15.2, decision D14) ---
# Evidence files are never deleted by the application. Default folder: data/evidence (in Docker: the app's data volume,
# which the backups include). Keep it on an encrypted disk that is not cloud-synced.
#EVIDENCE_DIR=
# Largest evidence file accepted, in MB. If you change it, change the matching limit in deploy/Caddyfile too.
#MAX_EVIDENCE_MB=100
# Minutes a download link stays valid (each link works once).
#EVIDENCE_DOWNLOAD_MINUTES=5
# Programs (e.g. malware samples) are accepted as evidence, marked, and never opened. false = refuse them.
#EVIDENCE_ACCEPT_PROGRAMS=true


# --- Case Management integrations (Step 15.6) ---
# The built-in FICTIONAL test source, which stands in for the Log Analyzer, CDR/IPDR, OSINT and alert systems until
# they exist. Set to false in production.
#CM_TEST_SOURCE=true
# The country code of a phone number written without one (a 10-digit national number).
#CM_PHONE_COUNTRY_CODE=91

# --- Case Management governance (Step 15.7, decisions D15 and D16) ---
# The application's own database login (no DELETE on case records). Docker creates it at start (scripts.db_roles).
#POSTGRES_APP_USER=caseapp
#POSTGRES_APP_PASSWORD=
# The key that signs audit checkpoints: at least 32 characters, held apart from the database administrators.
#CM_CHECKPOINT_KEY=
# The key that encrypts two-step verification secrets (at least 32 characters).
#MFA_KEY=
# Require two-step verification for privileged actions by platform administrators and supervisors (go-live: true).
#CM_MFA_REQUIRED=false
# How often the worker looks for due jobs, in seconds.
#CM_WORKER_INTERVAL=300
# How close a passage of a registered case (its summary and notes) must be to a passage of a past judgment to count as similar (0 to 1).
# Notes are looser than judgments, so this is lower than the bar for comparing two judgments (0.80). Lower finds more past cases, higher fewer.
#CASE_SIMILAR_PASSAGE_MIN_SIMILARITY=0.70
# Processor threads the case assistant's language model may use. 0 (the default) = all of this computer's processors. On the development laptop this made reading a question about 1.75 times faster than the 6 threads Ollama chose.
#CHAT_THREADS=0
# Officers in the officer register can create their own login on the log in page; it starts with view-only access (Viewer, public clearance)
# until a Supervisor or Administrator raises it. false switches the page off.
#SELF_REGISTRATION=true
# Sign-up attempts allowed from one computer per window (every attempt counts).
#MAX_SIGNUPS_PER_IP=10
#SIGNUP_WINDOW_MINUTES=60
